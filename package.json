{
  "name": "photogenic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 scaffold + foundation seams for the Photogenic cross-platform AI photo editor.",
  "scripts": {
    "test": "node --test --import tsx test/*.test.js && npm run test:components",
    "test:components": "node --test --import tsx --import ./test/setup/dom.js test/components/*.test.js",
    "build": "vite build",
    "build:legacy": "node scripts/build.mjs",
    "dev": "vite",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "tauri:attempt": "node scripts/tauri-attempt.mjs",
    "tauri:dev": "npx @tauri-apps/cli@2.11.4 dev",
    "tauri:build": "npx @tauri-apps/cli@2.11.4 build",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
